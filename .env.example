# Copy this file to .env and replace the placeholder values. .env is git-ignored.

# OpenAI API key used for the email summaries and draft replies
OPENAI_API_KEY=your-openai-api-key

# Address that receives the agent's notification emails (previews, drafts, sent summaries)
NOTIFY_EMAIL=you@example.com

# Address of the agent Gmail account (the one authorised as token_agent.json);
# its own notifications are hidden from the inbox list
AGENT_EMAIL=agent@example.com

# Optional. app.py and api.py switch LangSmith tracing on; with a key set here,
# email bodies and drafts are sent to LangSmith.
# LANGSMITH_API_KEY=your-langsmith-api-key
